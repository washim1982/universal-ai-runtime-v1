<Window x:Class="UarAdmin.Dialogs.AppCredentialsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Application credentials" Width="680" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="White" ShowInTaskbar="False">
  <StackPanel Margin="22">
    <StackPanel Orientation="Horizontal">
      <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE73E;" Foreground="{StaticResource Success}" FontSize="20" Margin="0,4,10,0"/>
      <TextBlock x:Name="Title1" Style="{StaticResource H1}" FontSize="19"/>
    </StackPanel>
    <Border Background="{StaticResource WarningSoft}" CornerRadius="6" Padding="10,8" Margin="0,12,0,12">
      <TextBlock TextWrapping="Wrap" Foreground="#92400E"
                 Text="Copy the client secret now and store it in your application's secret store. It is shown only once: the runtime keeps just a SHA-256 hash."/>
    </Border>

    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
      <TextBlock Text="Client ID" FontWeight="SemiBold" VerticalAlignment="Center"/>
      <TextBox x:Name="IdBox" Grid.Column="1" Style="{StaticResource Code}" Margin="0,3" Padding="6,4"/>
      <Button Grid.Column="2" Content="Copy" Click="CopyId_Click" Margin="8,3,0,3" Padding="10,3"/>
      <TextBlock Grid.Row="1" Text="Client secret" FontWeight="SemiBold" VerticalAlignment="Center"/>
      <TextBox x:Name="SecretBox" Grid.Row="1" Grid.Column="1" Style="{StaticResource Code}" Margin="0,3" Padding="6,4"/>
      <Button Grid.Row="1" Grid.Column="2" Content="Copy" Click="CopySecret_Click" Margin="8,3,0,3" Padding="10,3" Style="{StaticResource Primary}"/>
      <TextBlock Grid.Row="2" Text="Token URL" FontWeight="SemiBold" VerticalAlignment="Center"/>
      <TextBox x:Name="UrlBox" Grid.Row="2" Grid.Column="1" Style="{StaticResource Code}" Margin="0,3" Padding="6,4"/>
      <Button Grid.Row="2" Grid.Column="2" Content="Copy" Click="CopyUrl_Click" Margin="8,3,0,3" Padding="10,3"/>
    </Grid>

    <DockPanel Margin="0,14,0,4">
      <Button DockPanel.Dock="Right" Content="Copy example" Click="CopySnippet_Click" Margin="0" Padding="10,3"/>
      <TextBlock Text="Use it" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
      <ComboBox x:Name="SnippetBox" SelectedIndex="0" Width="170" HorizontalAlignment="Left" SelectionChanged="Snippet_Changed">
        <ComboBoxItem Content="PowerShell"/>
        <ComboBoxItem Content="curl"/>
        <ComboBoxItem Content="Python SDK"/>
        <ComboBoxItem Content="TypeScript SDK"/>
      </ComboBox>
    </DockPanel>
    <TextBox x:Name="Snippet" Style="{StaticResource Code}" Height="150"/>

    <Border x:Name="TestPanel" Background="#F8FAFC" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,12,0,0" Visibility="Collapsed">
      <TextBlock x:Name="TestText" FontFamily="{StaticResource Mono}" FontSize="12" TextWrapping="Wrap"/>
    </Border>

    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
      <Button x:Name="TestBtn" Click="Test_Click">
        <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE768;" Margin="0,2,8,0"/><TextBlock Text="Get a token and test it"/></StackPanel>
      </Button>
      <Button x:Name="UseBtn" Content="Use for UAR Admin" Click="Use_Click"
              ToolTip="Save as a connection that signs in with this application instead of an API key"/>
      <Button Content="Done" IsCancel="True" Click="Done_Click" Margin="0"/>
    </StackPanel>
  </StackPanel>
</Window>
