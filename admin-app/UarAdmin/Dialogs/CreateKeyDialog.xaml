<Window x:Class="UarAdmin.Dialogs.CreateKeyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New API key" Width="480" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="White" ShowInTaskbar="False">
  <StackPanel Margin="22">
    <TextBlock Text="New API key" Style="{StaticResource H1}" FontSize="19"/>
    <TextBlock Style="{StaticResource Sub}" Margin="0,4,0,16"
               Text="Give each application or person its own key with the fewest roles it needs."/>

    <TextBlock Text="Subject (who or what uses the key)" FontWeight="SemiBold"/>
    <TextBox x:Name="SubjectBox" Margin="0,4,0,12" ToolTip="e.g. reporting-bot@acme or jane@acme"/>

    <TextBlock Text="Roles" FontWeight="SemiBold"/>
    <Border BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,4,0,12" MaxHeight="190">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <ItemsControl x:Name="RoleList">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <CheckBox Content="{Binding Name}" IsChecked="{Binding Selected}" Width="130" Margin="0,3"/>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>

    <TextBlock Text="Expires" FontWeight="SemiBold"/>
    <ComboBox x:Name="ExpiryBox" Margin="0,4,0,12" SelectedIndex="2">
      <ComboBoxItem Content="In 7 days" Tag="7"/>
      <ComboBoxItem Content="In 30 days" Tag="30"/>
      <ComboBoxItem Content="In 90 days" Tag="90"/>
      <ComboBoxItem Content="In 1 year" Tag="365"/>
      <ComboBoxItem Content="Never" Tag="0"/>
    </ComboBox>

    <TextBlock Text="Description (optional)" FontWeight="SemiBold"/>
    <TextBox x:Name="DescriptionBox" Margin="0,4,0,8"/>

    <TextBlock x:Name="ErrorText" Foreground="{StaticResource Danger}" TextWrapping="Wrap" Margin="0,4,0,0"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="Cancel" IsCancel="True"/>
      <Button Content="Create key" Style="{StaticResource Primary}" IsDefault="True" Click="Create_Click" Margin="0"/>
    </StackPanel>
  </StackPanel>
</Window>
