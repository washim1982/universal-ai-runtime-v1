<UserControl x:Class="UarAdmin.Views.AuditPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="Audit trail" Style="{StaticResource H1}"/>
      <TextBlock Style="{StaticResource Sub}" Margin="0,4,0,12"
                 Text="Tamper-evident record of every sensitive action in this tenant. Each entry is chained to the previous one by a SHA-256 hash; Verify recomputes the whole chain."/>
    </StackPanel>
    <DockPanel Grid.Row="1" Margin="0,0,0,10">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button Content="Export JSON Lines…" Click="ExportJsonl_Click"/>
        <Button Content="Export CSV…" Click="ExportCsv_Click" Margin="0"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal">
        <Button Style="{StaticResource Primary}" Click="Verify_Click">
          <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xEA18;" Foreground="White" Margin="0,2,8,0"/><TextBlock Text="Verify chain" Foreground="White"/></StackPanel>
        </Button>
        <Button Content="Reload" Click="Reload_Click"/>
        <TextBlock Text="Filter" VerticalAlignment="Center" Margin="10,0,6,0"/>
        <TextBox x:Name="FilterBox" Width="240" TextChanged="Filter_Changed" ToolTip="actor, action, target, outcome or run id"/>
      </StackPanel>
    </DockPanel>
    <Border x:Name="VerifyBanner" Grid.Row="2" CornerRadius="8" Padding="12,8" Margin="0,0,0,10" Visibility="Collapsed">
      <TextBlock x:Name="VerifyText" TextWrapping="Wrap"/>
    </Border>
    <Grid Grid.Row="3">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="3*"/>
        <ColumnDefinition Width="16"/>
        <ColumnDefinition Width="2*"/>
      </Grid.ColumnDefinitions>
      <DockPanel>
        <TextBlock x:Name="CountText" DockPanel.Dock="Bottom" Style="{StaticResource Sub}" Margin="0,8,0,0"/>
        <DataGrid x:Name="Grid" SelectionChanged="Grid_SelectionChanged">
          <DataGrid.Columns>
            <DataGridTextColumn Header="#" Binding="{Binding Seq}" Width="50"/>
            <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="135"/>
            <DataGridTextColumn Header="Actor" Binding="{Binding Actor}" Width="120"/>
            <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="135" FontWeight="SemiBold"/>
            <DataGridTextColumn Header="Outcome" Binding="{Binding Outcome}" Width="75"/>
            <DataGridTextColumn Header="Target" Binding="{Binding Target}" Width="*"/>
          </DataGrid.Columns>
        </DataGrid>
      </DockPanel>
      <Border Grid.Column="2" Style="{StaticResource Card}">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="Entry" Style="{StaticResource H2}"/>
          <TextBox x:Name="Detail" Style="{StaticResource Code}" TextWrapping="Wrap" BorderThickness="0"/>
        </DockPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
