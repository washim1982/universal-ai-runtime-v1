<UserControl x:Class="UarAdmin.Views.KeysPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="3*"/>
      <RowDefinition Height="16"/>
      <RowDefinition Height="2*"/>
    </Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="Access &amp; keys" Style="{StaticResource H1}"/>
      <TextBlock Style="{StaticResource Sub}" Margin="0,4,0,12"
                 Text="API keys of this tenant. Keys created here take effect at once; the secret is shown one time only. Keys from the configuration file are listed read-only."/>
    </StackPanel>
    <DockPanel Grid.Row="1" Margin="0,0,0,10">
      <CheckBox x:Name="ShowRevoked" DockPanel.Dock="Right" Content="Show revoked and expired" VerticalAlignment="Center" Checked="Reload" Unchecked="Reload"/>
      <StackPanel Orientation="Horizontal">
        <Button Style="{StaticResource Primary}" Click="New_Click">
          <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE710;" Foreground="White" Margin="0,2,8,0"/><TextBlock Text="New API key" Foreground="White"/></StackPanel>
        </Button>
        <Button x:Name="RevokeBtn" Style="{StaticResource DangerButton}" Content="Revoke" Click="Revoke_Click" IsEnabled="False"/>
        <Button Content="Copy key id" Click="CopyId_Click"/>
        <Button Content="Refresh" Click="Reload"/>
      </StackPanel>
    </DockPanel>
    <DataGrid x:Name="Grid" Grid.Row="2" SelectionChanged="Grid_SelectionChanged">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Key id" Binding="{Binding KeyId}" Width="120" FontFamily="{StaticResource Mono}"/>
        <DataGridTextColumn Header="Subject" Binding="{Binding Subject}" Width="190"/>
        <DataGridTextColumn Header="Roles" Binding="{Binding Roles}" Width="160"/>
        <DataGridTemplateColumn Header="Status" Width="90">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <Border Style="{StaticResource Pill}" Background="{Binding StatusBg}" Padding="8,1">
                <TextBlock Text="{Binding Status}" Foreground="{Binding StatusFg}" FontSize="11" FontWeight="SemiBold"/>
              </Border>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="70"/>
        <DataGridTextColumn Header="Created" Binding="{Binding Created}" Width="140"/>
        <DataGridTextColumn Header="Expires" Binding="{Binding Expires}" Width="140"/>
        <DataGridTextColumn Header="Created by" Binding="{Binding CreatedBy}" Width="130"/>
        <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
      </DataGrid.Columns>
    </DataGrid>

    <Grid Grid.Row="4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="3*"/>
        <ColumnDefinition Width="16"/>
        <ColumnDefinition Width="2*"/>
      </Grid.ColumnDefinitions>
      <Border Style="{StaticResource Card}" Padding="12">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="Roles and permissions" Style="{StaticResource H2}"/>
          <DataGrid x:Name="RolesGrid" BorderThickness="0" RowHeight="NaN">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Role" Binding="{Binding Name}" Width="110" FontWeight="SemiBold"/>
              <DataGridTextColumn Header="Permissions" Binding="{Binding Permissions}" Width="*">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,4"/></Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </Border>
      <Border Grid.Column="2" Style="{StaticResource Card}" Padding="12">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="Single sign-on (OIDC)" Style="{StaticResource H2}"/>
          <TextBlock DockPanel.Dock="Top" Style="{StaticResource Sub}" Margin="0,0,0,8" FontSize="12"
                     Text="Identity-provider groups and service accounts mapped to roles. Configured in the runtime configuration (auth.oidc)."/>
          <TextBox x:Name="OidcText" Style="{StaticResource Code}" BorderThickness="0"/>
        </DockPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
