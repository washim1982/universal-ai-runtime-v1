<UserControl x:Class="UarAdmin.Views.OverviewPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel>
      <TextBlock Text="Overview" Style="{StaticResource H1}"/>
      <TextBlock Text="Runtime status, start / stop / restart, and the health of every component." Style="{StaticResource Sub}" Margin="0,4,0,16"/>

      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="3*"/>
          <ColumnDefinition Width="16"/>
          <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <!-- runtime control -->
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <DockPanel>
              <Border x:Name="StatePill" Style="{StaticResource Pill}" DockPanel.Dock="Right" Background="#E2E8F0">
                <TextBlock x:Name="StateText" Text="…" FontWeight="SemiBold" FontSize="12"/>
              </Border>
              <TextBlock Text="Runtime" Style="{StaticResource H2}"/>
            </DockPanel>
            <Grid Margin="0,4,0,14">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
              </Grid.RowDefinitions>
              <TextBlock Text="Endpoint" Style="{StaticResource Sub}" Margin="0,3"/>
              <TextBlock x:Name="UrlText" Grid.Column="1" Margin="0,3" FontFamily="{StaticResource Mono}"/>
              <TextBlock Grid.Row="1" Text="Mode" Style="{StaticResource Sub}" Margin="0,3"/>
              <TextBlock x:Name="ModeText" Grid.Row="1" Grid.Column="1" Margin="0,3" TextWrapping="Wrap"/>
              <TextBlock Grid.Row="2" Text="Version / profile" Style="{StaticResource Sub}" Margin="0,3"/>
              <TextBlock x:Name="VersionText" Grid.Row="2" Grid.Column="1" Margin="0,3"/>
              <TextBlock Grid.Row="3" Text="Up since" Style="{StaticResource Sub}" Margin="0,3"/>
              <TextBlock x:Name="UptimeText" Grid.Row="3" Grid.Column="1" Margin="0,3"/>
              <TextBlock Grid.Row="4" Text="Host / process" Style="{StaticResource Sub}" Margin="0,3"/>
              <TextBlock x:Name="HostText" Grid.Row="4" Grid.Column="1" Margin="0,3"/>
              <TextBlock Grid.Row="5" Text="Database schema" Style="{StaticResource Sub}" Margin="0,3"/>
              <TextBlock x:Name="MigrationsText" Grid.Row="5" Grid.Column="1" Margin="0,3" TextWrapping="Wrap"/>
            </Grid>
            <WrapPanel>
              <Button x:Name="StartBtn" Style="{StaticResource SuccessButton}" Click="Start_Click">
                <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE768;" Foreground="White" Margin="0,2,8,0"/><TextBlock Text="Start" Foreground="White"/></StackPanel>
              </Button>
              <Button x:Name="RestartBtn" Click="Restart_Click">
                <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72C;" Margin="0,2,8,0"/><TextBlock Text="Restart"/></StackPanel>
              </Button>
              <Button x:Name="StopBtn" Style="{StaticResource DangerButton}" Click="Stop_Click">
                <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE71A;" Foreground="White" Margin="0,2,8,0"/><TextBlock Text="Stop" Foreground="White"/></StackPanel>
              </Button>
              <Button Content="Open runtime folder" Click="OpenFolder_Click"/>
            </WrapPanel>
            <TextBlock x:Name="CommandText" Style="{StaticResource Sub}" Margin="0,12,0,0" FontFamily="{StaticResource Mono}" FontSize="11"/>
          </StackPanel>
        </Border>

        <!-- quick numbers -->
        <StackPanel Grid.Column="2">
          <Border Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
              <TextBlock Text="Signed in as" Style="{StaticResource Sub}"/>
              <TextBlock x:Name="WhoText" FontSize="16" FontWeight="SemiBold" Margin="0,2,0,0"/>
              <TextBlock x:Name="TenantText" Style="{StaticResource Sub}"/>
            </StackPanel>
          </Border>
          <UniformGrid Columns="2">
            <Border Style="{StaticResource Card}" Margin="0,0,6,12">
              <StackPanel>
                <TextBlock Text="Pending approvals" Style="{StaticResource Sub}"/>
                <TextBlock x:Name="PendingNum" Text="–" FontSize="26" FontWeight="SemiBold"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="6,0,0,12">
              <StackPanel>
                <TextBlock Text="Model calls (24 h)" Style="{StaticResource Sub}"/>
                <TextBlock x:Name="CallsNum" Text="–" FontSize="26" FontWeight="SemiBold"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,6,0">
              <StackPanel>
                <TextBlock Text="Tokens (24 h)" Style="{StaticResource Sub}"/>
                <TextBlock x:Name="TokensNum" Text="–" FontSize="26" FontWeight="SemiBold"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="6,0,0,0">
              <StackPanel>
                <TextBlock Text="Cost (24 h)" Style="{StaticResource Sub}"/>
                <TextBlock x:Name="CostNum" Text="–" FontSize="26" FontWeight="SemiBold"/>
              </StackPanel>
            </Border>
          </UniformGrid>
        </StackPanel>
      </Grid>

      <!-- components -->
      <Border Style="{StaticResource Card}" Margin="0,16,0,0">
        <StackPanel>
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="Refresh" Click="Refresh_Click" Margin="0"/>
            <TextBlock Text="Services and components" Style="{StaticResource H2}"/>
          </DockPanel>
          <TextBlock x:Name="ComponentsHint" Style="{StaticResource Sub}" Margin="0,0,0,8"/>
          <ItemsControl x:Name="Components">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Width="250" Margin="0,0,10,10" Padding="12,10" CornerRadius="8" BorderThickness="1" BorderBrush="{StaticResource Line}" Background="#FBFDFF">
                  <DockPanel>
                    <Ellipse DockPanel.Dock="Left" Width="10" Height="10" Fill="{Binding Dot}" VerticalAlignment="Top" Margin="0,5,10,0"/>
                    <StackPanel>
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Text="{Binding Kind}" Style="{StaticResource Sub}" FontSize="11"/>
                      <TextBlock Text="{Binding Status}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                  </DockPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
