<UserControl x:Class="UarAdmin.Views.AppsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="Applications" Style="{StaticResource H1}"/>
      <TextBlock Style="{StaticResource Sub}" Margin="0,4,0,12"
                 Text="Register an application to get a client ID and secret. The application exchanges them at the token service (STS) for a short-lived access token and calls inference or any other endpoint with it."/>
    </StackPanel>

    <!-- token service -->
    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14,12" Margin="0,0,0,12">
      <DockPanel>
        <Button x:Name="RotateBtn" DockPanel.Dock="Right" Content="Rotate signing key" Click="Rotate_Click" Margin="0" VerticalAlignment="Center"
                ToolTip="Create a new signing key; tokens already issued stay valid until they expire"/>
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="Token service (STS)" FontWeight="SemiBold" FontSize="14"/>
            <Border x:Name="ModePill" Style="{StaticResource Pill}" Margin="10,0,0,0" Background="{StaticResource AccentSoft}">
              <TextBlock x:Name="ModeText" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Accent}"/>
            </Border>
          </StackPanel>
          <TextBlock x:Name="StsText" FontFamily="{StaticResource Mono}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <DockPanel Grid.Row="2" Margin="0,0,0,10">
      <CheckBox x:Name="ShowDisabled" DockPanel.Dock="Right" Content="Show disabled" VerticalAlignment="Center" Checked="Reload" Unchecked="Reload"/>
      <StackPanel Orientation="Horizontal">
        <Button Style="{StaticResource Primary}" Click="Register_Click">
          <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE710;" Foreground="White" Margin="0,2,8,0"/><TextBlock Text="Register application" Foreground="White"/></StackPanel>
        </Button>
        <Button x:Name="SecretBtn" Content="New client secret" Click="NewSecret_Click" IsEnabled="False"/>
        <Button x:Name="DisableBtn" Style="{StaticResource DangerButton}" Content="Disable application" Click="Disable_Click" IsEnabled="False"/>
        <Button Content="Refresh" Click="Reload"/>
      </StackPanel>
    </DockPanel>

    <Grid Grid.Row="3">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="3*"/>
        <ColumnDefinition Width="16"/>
        <ColumnDefinition Width="2*"/>
      </Grid.ColumnDefinitions>
      <TextBlock x:Name="EmptyHint" Panel.ZIndex="1" Margin="0,60,0,0" HorizontalAlignment="Center" TextAlignment="Center"
                 Style="{StaticResource Sub}" Visibility="Collapsed"
                 Text="No applications yet.&#x0a;Click Register application to create a client ID and secret for a program."/>
      <DataGrid x:Name="Grid" SelectionChanged="Grid_SelectionChanged">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Application" Binding="{Binding Name}" Width="140" FontWeight="SemiBold"/>
          <DataGridTextColumn Header="Client ID" Binding="{Binding ClientId}" Width="*" MinWidth="150" FontFamily="{StaticResource Mono}"/>
          <DataGridTextColumn Header="Roles" Binding="{Binding Roles}" Width="100"/>
          <DataGridTextColumn Header="Token" Binding="{Binding Ttl}" Width="70"/>
          <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="72"/>
          <DataGridTextColumn Header="Last token" Binding="{Binding LastToken}" Width="130"/>
        </DataGrid.Columns>
      </DataGrid>
      <Border Grid.Column="2" Style="{StaticResource Card}">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top">
            <TextBlock x:Name="DTitle" Text="Select an application" Style="{StaticResource H2}"/>
            <TextBlock x:Name="DMeta" Style="{StaticResource Sub}" FontSize="12"/>
            <TextBlock Text="Client secrets" FontWeight="SemiBold" Margin="0,12,0,4"/>
          </StackPanel>
          <StackPanel DockPanel.Dock="Bottom">
            <DockPanel Margin="0,10,0,4">
              <Button DockPanel.Dock="Right" Content="Copy" Click="CopySnippet_Click" Margin="0" Padding="10,3"/>
              <ComboBox x:Name="SnippetBox" SelectedIndex="0" SelectionChanged="Snippet_Changed" Width="180" HorizontalAlignment="Left">
                <ComboBoxItem Content="PowerShell"/>
                <ComboBoxItem Content="curl"/>
                <ComboBoxItem Content="Python SDK"/>
                <ComboBoxItem Content="TypeScript SDK"/>
              </ComboBox>
            </DockPanel>
            <TextBox x:Name="Snippet" Style="{StaticResource Code}" Height="170"/>
          </StackPanel>
          <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
            <Button x:Name="RevokeSecretBtn" Content="Revoke selected secret" Click="RevokeSecret_Click" IsEnabled="False" Margin="0"/>
            <TextBlock/>
          </DockPanel>
          <DataGrid x:Name="Secrets" SelectionChanged="Secrets_SelectionChanged" MinHeight="80">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Secret" Binding="{Binding Hint}" Width="70" FontFamily="{StaticResource Mono}"/>
              <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="65"/>
              <DataGridTextColumn Header="Created" Binding="{Binding Created}" Width="*"/>
              <DataGridTextColumn Header="Expires" Binding="{Binding Expires}" Width="*"/>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
