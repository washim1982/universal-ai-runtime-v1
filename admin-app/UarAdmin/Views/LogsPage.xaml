<UserControl x:Class="UarAdmin.Views.LogsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="Service logs" Style="{StaticResource H1}"/>
      <TextBlock Style="{StaticResource Sub}" Margin="0,4,0,12"
                 Text="Live runtime logs (sensitive fields redacted), the console output of a runtime started by UAR Admin, or the Docker container's log."/>
    </StackPanel>
    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12" Margin="0,0,0,10">
      <WrapPanel>
        <TextBlock Text="Source" VerticalAlignment="Center" Margin="0,0,6,0"/>
        <ComboBox x:Name="SourceBox" SelectedIndex="0" Width="250" Margin="0,0,14,0" SelectionChanged="Source_Changed">
          <ComboBoxItem Content="Runtime (live, via API)" Tag="api"/>
          <ComboBoxItem Content="Process output (started by UAR Admin)" Tag="process"/>
          <ComboBoxItem Content="Docker container log" Tag="docker"/>
        </ComboBox>
        <TextBlock Text="Level" VerticalAlignment="Center" Margin="0,0,6,0"/>
        <ComboBox x:Name="LevelBox" SelectedIndex="1" Width="100" Margin="0,0,14,0" SelectionChanged="Level_Changed">
          <ComboBoxItem Content="DEBUG"/>
          <ComboBoxItem Content="INFO"/>
          <ComboBoxItem Content="WARNING"/>
          <ComboBoxItem Content="ERROR"/>
        </ComboBox>
        <TextBlock Text="Search" VerticalAlignment="Center" Margin="0,0,6,0"/>
        <TextBox x:Name="SearchBox" Width="200" Margin="0,0,14,0" TextChanged="Search_Changed"/>
        <ToggleButton x:Name="PauseBtn" Content="Pause" Padding="12,5" Margin="0,0,8,0"/>
        <Button Content="Clear" Click="Clear_Click"/>
        <Button Content="Save…" Click="Save_Click"/>
        <Button Content="Open log folder" Click="OpenFolder_Click" Margin="0"/>
      </WrapPanel>
    </Border>
    <Grid Grid.Row="2">
      <Grid.RowDefinitions>
        <RowDefinition Height="3*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <DataGrid x:Name="Grid" FontFamily="{StaticResource Mono}" FontSize="12" RowHeight="24" SelectionChanged="Grid_SelectionChanged">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="160"/>
          <DataGridTemplateColumn Header="Level" Width="80">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate><TextBlock Text="{Binding Level}" Foreground="{Binding LevelBrush}" FontWeight="SemiBold"/></DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="Logger" Binding="{Binding Logger}" Width="150"/>
          <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*"/>
        </DataGrid.Columns>
      </DataGrid>
      <TextBox x:Name="Detail" Grid.Row="1" Style="{StaticResource Code}" Height="130" Margin="0,8,0,0" TextWrapping="Wrap"/>
    </Grid>
    <TextBlock x:Name="StatusText" Grid.Row="3" Style="{StaticResource Sub}" Margin="0,8,0,0"/>
  </Grid>
</UserControl>
