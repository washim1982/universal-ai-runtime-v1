<UserControl x:Class="UarAdmin.Views.UsagePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="Inference history" Style="{StaticResource H1}"/>
      <TextBlock Style="{StaticResource Sub}" Margin="0,4,0,12"
                 Text="Every model call of this tenant from the usage ledger: who, which model, tokens and cost. Prompts and outputs are never stored here."/>
    </StackPanel>
    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12" Margin="0,0,0,12">
      <WrapPanel VerticalAlignment="Center">
        <TextBlock Text="Subject" VerticalAlignment="Center" Margin="0,0,6,0"/>
        <TextBox x:Name="SubjectBox" Width="170" Margin="0,0,14,0"/>
        <TextBlock Text="Model contains" VerticalAlignment="Center" Margin="0,0,6,0"/>
        <TextBox x:Name="ModelBox" Width="150" Margin="0,0,14,0"/>
        <TextBlock Text="Since" VerticalAlignment="Center" Margin="0,0,6,0"/>
        <ComboBox x:Name="SinceBox" SelectedIndex="1" Margin="0,0,14,0">
          <ComboBoxItem Content="Last hour" Tag="1"/>
          <ComboBoxItem Content="Last 24 hours" Tag="24"/>
          <ComboBoxItem Content="Last 7 days" Tag="168"/>
          <ComboBoxItem Content="Last 30 days" Tag="720"/>
          <ComboBoxItem Content="All time" Tag="0"/>
        </ComboBox>
        <Button Content="Search" Style="{StaticResource Primary}" Click="Search_Click" IsDefault="True"/>
        <Button Content="Export CSV…" Click="Export_Click"/>
      </WrapPanel>
    </Border>
    <UniformGrid Grid.Row="2" Columns="4" Margin="0,0,0,12">
      <Border Style="{StaticResource Card}" Margin="0,0,8,0" Padding="12">
        <StackPanel><TextBlock Text="Model calls" Style="{StaticResource Sub}"/><TextBlock x:Name="TotRequests" Text="–" FontSize="22" FontWeight="SemiBold"/></StackPanel>
      </Border>
      <Border Style="{StaticResource Card}" Margin="4,0,4,0" Padding="12">
        <StackPanel><TextBlock Text="Input tokens" Style="{StaticResource Sub}"/><TextBlock x:Name="TotIn" Text="–" FontSize="22" FontWeight="SemiBold"/></StackPanel>
      </Border>
      <Border Style="{StaticResource Card}" Margin="4,0,4,0" Padding="12">
        <StackPanel><TextBlock Text="Output tokens" Style="{StaticResource Sub}"/><TextBlock x:Name="TotOut" Text="–" FontSize="22" FontWeight="SemiBold"/></StackPanel>
      </Border>
      <Border Style="{StaticResource Card}" Margin="8,0,0,0" Padding="12">
        <StackPanel><TextBlock Text="Cost (known prices)" Style="{StaticResource Sub}"/><TextBlock x:Name="TotCost" Text="–" FontSize="22" FontWeight="SemiBold"/></StackPanel>
      </Border>
    </UniformGrid>
    <DataGrid x:Name="Grid" Grid.Row="3">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="145"/>
        <DataGridTextColumn Header="Subject" Binding="{Binding Subject}" Width="150"/>
        <DataGridTextColumn Header="Provider" Binding="{Binding Provider}" Width="100"/>
        <DataGridTextColumn Header="Model" Binding="{Binding Model}" Width="180"/>
        <DataGridTextColumn Header="In" Binding="{Binding In, StringFormat=N0}" Width="70"/>
        <DataGridTextColumn Header="Out" Binding="{Binding Out, StringFormat=N0}" Width="70"/>
        <DataGridTextColumn Header="Cost" Binding="{Binding Cost}" Width="100"/>
        <DataGridTextColumn Header="Est." Binding="{Binding Estimated}" Width="45"/>
        <DataGridTextColumn Header="Run" Binding="{Binding RunId}" Width="190" FontFamily="{StaticResource Mono}"/>
        <DataGridTextColumn Header="Request" Binding="{Binding RequestId}" Width="*" FontFamily="{StaticResource Mono}"/>
      </DataGrid.Columns>
    </DataGrid>
    <DockPanel Grid.Row="4" Margin="0,10,0,0">
      <Button x:Name="MoreBtn" DockPanel.Dock="Right" Content="Load more" Click="More_Click" Margin="0" IsEnabled="False"/>
      <TextBlock x:Name="CountText" Style="{StaticResource Sub}" VerticalAlignment="Center"/>
    </DockPanel>
  </Grid>
</UserControl>
