<UserControl x:Class="UarAdmin.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel MaxWidth="980" HorizontalAlignment="Left">
      <TextBlock Text="Settings" Style="{StaticResource H1}"/>
      <TextBlock Style="{StaticResource Sub}" Margin="0,4,0,16"
                 Text="Connections to runtimes and where the local runtime lives. API keys are encrypted for your Windows account (DPAPI)."/>

      <Border Style="{StaticResource Card}" Margin="0,0,0,16">
        <StackPanel>
          <TextBlock Text="Connections" Style="{StaticResource H2}"/>
          <TextBlock Style="{StaticResource Sub}" Margin="0,0,0,10" FontSize="12"
                     Text="Each connection is a runtime URL and an API key. Use an admin key; one connection per tenant."/>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="300"/>
              <ColumnDefinition Width="20"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <DockPanel>
              <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="New" Click="NewProfile_Click"/>
                <Button Content="Delete" Click="DeleteProfile_Click"/>
                <Button Content="Import local admin key" Click="Import_Click" Margin="0"
                        ToolTip="Read UAR_ADMIN_KEY from .local\credentials.env in the runtime folder"/>
              </StackPanel>
              <ListBox x:Name="Profiles" Height="170" SelectionChanged="Profiles_SelectionChanged" DisplayMemberPath="Name"/>
            </DockPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="Name" FontWeight="SemiBold"/>
              <TextBox x:Name="PName" Margin="0,4,0,10"/>
              <TextBlock Text="Runtime URL" FontWeight="SemiBold"/>
              <TextBox x:Name="PUrl" Margin="0,4,0,10" FontFamily="{StaticResource Mono}"/>
              <TextBlock Text="API key (leave empty to keep the saved key)" FontWeight="SemiBold"/>
              <PasswordBox x:Name="PKey" Margin="0,4,0,12"/>
              <StackPanel Orientation="Horizontal">
                <Button Content="Save connection" Style="{StaticResource Primary}" Click="SaveProfile_Click"/>
                <Button Content="Use this connection" Click="UseProfile_Click"/>
                <Button Content="Test" Click="Test_Click" Margin="0"/>
              </StackPanel>
              <TextBlock x:Name="TestText" TextWrapping="Wrap" Margin="0,10,0,0"/>
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}" Margin="0,0,0,16">
        <StackPanel>
          <TextBlock Text="Local runtime" Style="{StaticResource H2}"/>
          <TextBlock Style="{StaticResource Sub}" Margin="0,0,0,10" FontSize="12"
                     Text="Used by Start / Restart on the Overview page. Set up the folder first with the setup dashboard (setup.cmd)."/>
          <TextBlock Text="Runtime folder (the repository)" FontWeight="SemiBold"/>
          <DockPanel Margin="0,4,0,10">
            <Button DockPanel.Dock="Right" Content="Browse…" Click="Browse_Click" Margin="8,0,0,0"/>
            <TextBox x:Name="RootBox" FontFamily="{StaticResource Mono}"/>
          </DockPanel>
          <TextBlock Text="Configuration file (relative to the folder)" FontWeight="SemiBold"/>
          <TextBox x:Name="ConfigBox" Margin="0,4,0,10" FontFamily="{StaticResource Mono}"/>
          <TextBlock Text="Refresh interval (seconds)" FontWeight="SemiBold"/>
          <TextBox x:Name="RefreshBox" Width="80" HorizontalAlignment="Left" Margin="0,4,0,12"/>
          <StackPanel Orientation="Horizontal">
            <Button Content="Save" Style="{StaticResource Primary}" Click="SaveRuntime_Click"/>
            <TextBlock x:Name="RootHint" Style="{StaticResource Sub}" VerticalAlignment="Center" FontSize="12"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="About" Style="{StaticResource H2}"/>
          <TextBlock x:Name="AboutText" Style="{StaticResource Sub}" FontSize="12"/>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
