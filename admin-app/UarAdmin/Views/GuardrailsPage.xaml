<UserControl x:Class="UarAdmin.Views.GuardrailsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="Guardrails" Style="{StaticResource H1}"/>
      <TextBlock Style="{StaticResource Sub}" Margin="0,4,0,12"
                 Text="Security checks on every model call: prompt injection and jailbreaks, personal data (PII), payment card data (PCI), secrets and denied terms, on the prompt, on tool results and on the answer."/>
    </StackPanel>

    <!-- policy -->
    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14,12" Margin="0,0,0,12">
      <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
          <Button DockPanel.Dock="Right" Content="Refresh" Click="Refresh_Click" Margin="0"/>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="Policy in force" FontWeight="SemiBold" FontSize="14"/>
            <Border x:Name="StatePill" Style="{StaticResource Pill}" Margin="10,0,0,0" Background="{StaticResource SuccessSoft}">
              <TextBlock x:Name="StateText" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Success}"/>
            </Border>
          </StackPanel>
        </DockPanel>
        <DataGrid x:Name="PolicyGrid" BorderThickness="0" MaxHeight="130" RowHeight="26">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Stage" Binding="{Binding Stage}" Width="110" FontWeight="SemiBold"/>
            <DataGridTextColumn Header="Prompt injection" Binding="{Binding Injection}" Width="*"/>
            <DataGridTextColumn Header="PII" Binding="{Binding Pii}" Width="*"/>
            <DataGridTextColumn Header="PCI" Binding="{Binding Pci}" Width="*"/>
            <DataGridTextColumn Header="Secrets" Binding="{Binding Secrets}" Width="*"/>
            <DataGridTextColumn Header="Denied terms" Binding="{Binding Terms}" Width="*"/>
            <DataGridTextColumn Header="Max size" Binding="{Binding MaxChars}" Width="80"/>
          </DataGrid.Columns>
        </DataGrid>
      </DockPanel>
    </Border>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="16"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- test console -->
      <Border Style="{StaticResource Card}">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="Test content" Style="{StaticResource H2}"/>
          <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock Text="Check as" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox x:Name="StageBox" SelectedIndex="0" Width="150" Margin="0,0,12,0">
              <ComboBoxItem Content="prompt (input)" Tag="input"/>
              <ComboBoxItem Content="tool result" Tag="tool_results"/>
              <ComboBoxItem Content="model answer (output)" Tag="output"/>
            </ComboBox>
            <TextBlock Text="Examples:" VerticalAlignment="Center" Margin="0,0,6,0" Style="{StaticResource Sub}"/>
            <Button Content="Injection" Padding="8,3" Click="Example_Click" Tag="injection"/>
            <Button Content="PII" Padding="8,3" Click="Example_Click" Tag="pii"/>
            <Button Content="Card" Padding="8,3" Click="Example_Click" Tag="pci"/>
            <Button Content="Secret" Padding="8,3" Click="Example_Click" Tag="secret"/>
            <Button Content="Hidden text" Padding="8,3" Click="Example_Click" Tag="hidden" Margin="0"/>
          </WrapPanel>
          <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <Button x:Name="CheckBtn" DockPanel.Dock="Left" Style="{StaticResource Primary}" Content="Check" Click="Check_Click"/>
            <Border x:Name="Verdict" CornerRadius="6" Padding="10,5" Visibility="Collapsed">
              <TextBlock x:Name="VerdictText" FontWeight="SemiBold" TextWrapping="Wrap"/>
            </Border>
          </DockPanel>
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="2*"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBox x:Name="Input" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"/>
            <TextBlock Grid.Row="1" Text="Findings" FontWeight="SemiBold" Margin="0,8,0,4"/>
            <DataGrid x:Name="Findings" Grid.Row="2">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Check" Binding="{Binding Check}" Width="120"/>
                <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="*"/>
                <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="65"/>
                <DataGridTextColumn Header="Count" Binding="{Binding Count}" Width="50"/>
                <DataGridTextColumn Header="Score" Binding="{Binding Score}" Width="50"/>
              </DataGrid.Columns>
            </DataGrid>
            <TextBlock Grid.Row="3" Text="What the model would receive / the caller would see" FontWeight="SemiBold" Margin="0,8,0,4"/>
            <TextBox x:Name="Redacted" Grid.Row="4" Style="{StaticResource Code}" TextWrapping="Wrap"/>
          </Grid>
        </DockPanel>
      </Border>

      <!-- recent events -->
      <Border Grid.Column="2" Style="{StaticResource Card}">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top">
            <Button DockPanel.Dock="Right" Content="Load events" Click="Events_Click" Margin="0"/>
            <TextBlock Text="Recent guardrail events" Style="{StaticResource H2}"/>
          </DockPanel>
          <TextBlock x:Name="EventsHint" DockPanel.Dock="Top" Style="{StaticResource Sub}" FontSize="12" Margin="0,0,0,6"
                     Text="From the audit trail: what was blocked, redacted or flagged, by whom and on which model. The content itself is never stored."/>
          <TextBox x:Name="EventDetail" DockPanel.Dock="Bottom" Style="{StaticResource Code}" Height="120" Margin="0,8,0,0" TextWrapping="Wrap"/>
          <DataGrid x:Name="Events" SelectionChanged="Events_SelectionChanged">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="130"/>
              <DataGridTextColumn Header="Outcome" Binding="{Binding Outcome}" Width="70" FontWeight="SemiBold"/>
              <DataGridTextColumn Header="Who" Binding="{Binding Actor}" Width="120"/>
              <DataGridTextColumn Header="Checks" Binding="{Binding Summary}" Width="*"/>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
