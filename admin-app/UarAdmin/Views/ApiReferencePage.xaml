<UserControl x:Class="UarAdmin.Views.ApiReferencePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,12">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
        <Button Content="Save openapi.json…" Click="Save_Click"/>
        <Button Content="Reload" Click="Reload_Click" Margin="0"/>
      </StackPanel>
      <StackPanel>
        <TextBlock Text="API reference" Style="{StaticResource H1}"/>
        <TextBlock x:Name="Subtitle" Style="{StaticResource Sub}" Margin="0,4,0,0"
                   Text="Every HTTP/JSON endpoint of the runtime, generated from the canonical proto contract. gRPC offers the same operations."/>
      </StackPanel>
    </DockPanel>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="400"/>
        <ColumnDefinition Width="16"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Border Style="{StaticResource Card}" Padding="10">
        <DockPanel>
          <TextBox x:Name="Search" DockPanel.Dock="Top" Margin="0,0,0,8" TextChanged="Search_Changed" ToolTip="Filter by path, operation or description"/>
          <ListBox x:Name="Ops" BorderThickness="0" SelectionChanged="Ops_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="0,4">
                  <StackPanel Orientation="Horizontal">
                    <Border CornerRadius="4" Padding="6,1" Width="54" Background="{Binding MethodBg}">
                      <TextBlock Text="{Binding Method}" Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="{Binding Path}" FontFamily="{StaticResource Mono}" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center"/>
                  </StackPanel>
                  <TextBlock Text="{Binding OperationId}" Style="{StaticResource Sub}" FontSize="11" Margin="62,2,0,0"/>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <Border Grid.Column="2" Style="{StaticResource Card}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <Border x:Name="MethodBadge" CornerRadius="4" Padding="8,2" Background="#64748B">
                <TextBlock x:Name="MethodText" Text="-" Foreground="White" FontWeight="Bold"/>
              </Border>
              <TextBlock x:Name="PathText" FontFamily="{StaticResource Mono}" FontSize="15" Margin="10,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock x:Name="DescText" Style="{StaticResource Sub}" Margin="0,8,0,4"/>
            <TextBlock x:Name="ParamsText" FontFamily="{StaticResource Mono}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,8"/>
          </StackPanel>
          <TabControl Grid.Row="1" BorderBrush="{StaticResource Line}">
            <TabItem Header="Request">
              <TextBox x:Name="RequestSchema" Style="{StaticResource Code}" BorderThickness="0"/>
            </TabItem>
            <TabItem Header="Response">
              <TextBox x:Name="ResponseSchema" Style="{StaticResource Code}" BorderThickness="0"/>
            </TabItem>
            <TabItem Header="Try it">
              <Grid Margin="4">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="*"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="2*"/>
                </Grid.RowDefinitions>
                <DockPanel Margin="0,4,0,6">
                  <Button x:Name="SendBtn" DockPanel.Dock="Right" Content="Send" Style="{StaticResource Primary}" Click="Send_Click" Margin="8,0,0,0"/>
                  <TextBox x:Name="TryPath" FontFamily="{StaticResource Mono}" ToolTip="Path with parameters filled in; add ?query=values as needed"/>
                </DockPanel>
                <TextBox x:Name="TryBody" Grid.Row="1" Style="{StaticResource Code}" IsReadOnly="False" Background="White" ToolTip="JSON request body (POST)"/>
                <TextBlock x:Name="TryStatus" Grid.Row="2" Margin="0,8,0,4" FontWeight="SemiBold"/>
                <TextBox x:Name="TryResult" Grid.Row="3" Style="{StaticResource Code}"/>
              </Grid>
            </TabItem>
            <TabItem Header="curl">
              <DockPanel>
                <Button DockPanel.Dock="Top" HorizontalAlignment="Left" Content="Copy" Click="CopyCurl_Click" Margin="4,6"/>
                <TextBox x:Name="CurlText" Style="{StaticResource Code}" TextWrapping="Wrap" BorderThickness="0"/>
              </DockPanel>
            </TabItem>
          </TabControl>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
