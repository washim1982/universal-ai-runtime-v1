<Window x:Class="UarAdmin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UAR Admin - Universal AI Runtime" Height="820" Width="1320" MinHeight="600" MinWidth="1000"
        Icon="Assets/uar.ico" Background="{StaticResource Bg}" WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="232"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- sidebar -->
    <DockPanel Background="{StaticResource Side}">
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="18,20,12,22">
        <Image Source="Assets/uar.ico" Width="30" Height="30"/>
        <StackPanel Margin="10,0,0,0">
          <TextBlock Text="UAR Admin" Foreground="White" FontSize="17" FontWeight="SemiBold"/>
          <TextBlock Text="Universal AI Runtime" Foreground="#94A3B8" FontSize="11"/>
        </StackPanel>
      </StackPanel>

      <Border DockPanel.Dock="Bottom" Margin="12,8,12,14" Padding="10" CornerRadius="8" Background="{StaticResource SideHover}">
        <StackPanel>
          <TextBlock Text="CONNECTION" Foreground="#94A3B8" FontSize="10" FontWeight="SemiBold"/>
          <ComboBox x:Name="ProfileBox" Margin="0,6,0,8" SelectionChanged="ProfileBox_Changed"/>
          <StackPanel Orientation="Horizontal">
            <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="#64748B" VerticalAlignment="Center"/>
            <TextBlock x:Name="StatusText" Text="checking…" Foreground="{StaticResource SideText}" Margin="7,0,0,0"
                       FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="170"/>
          </StackPanel>
          <TextBlock x:Name="IdentityText" Foreground="#94A3B8" FontSize="11" Margin="16,3,0,0"
                     TextTrimming="CharacterEllipsis" MaxWidth="170"/>
        </StackPanel>
      </Border>

      <StackPanel x:Name="Nav">
        <RadioButton Style="{StaticResource Nav}" Tag="overview" IsChecked="True" Checked="Nav_Checked">
          <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE80F;" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Margin="0,2,12,0"/><TextBlock Text="Overview" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel>
        </RadioButton>
        <RadioButton Style="{StaticResource Nav}" Tag="keys" Checked="Nav_Checked">
          <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8D7;" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Margin="0,2,12,0"/><TextBlock Text="Access &amp; keys" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel>
        </RadioButton>
        <RadioButton Style="{StaticResource Nav}" Tag="apps" Checked="Nav_Checked">
          <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE71D;" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Margin="0,2,12,0"/><TextBlock Text="Applications" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel>
        </RadioButton>
        <RadioButton Style="{StaticResource Nav}" Tag="api" Checked="Nav_Checked">
          <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE943;" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Margin="0,2,12,0"/><TextBlock Text="API reference" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel>
        </RadioButton>
        <RadioButton Style="{StaticResource Nav}" Tag="usage" Checked="Nav_Checked">
          <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE81C;" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Margin="0,2,12,0"/><TextBlock Text="Inference history" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel>
        </RadioButton>
        <RadioButton Style="{StaticResource Nav}" Tag="approvals" Checked="Nav_Checked">
          <Grid>
            <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE73E;" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Margin="0,2,12,0"/><TextBlock Text="Approvals" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel>
            <Border x:Name="PendingBadge" Background="{StaticResource Warning}" CornerRadius="9" Padding="7,0" HorizontalAlignment="Right"
                    Margin="130,0,0,0" Visibility="Collapsed">
              <TextBlock x:Name="PendingText" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
            </Border>
          </Grid>
        </RadioButton>
        <RadioButton Style="{StaticResource Nav}" Tag="audit" Checked="Nav_Checked">
          <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xEA18;" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Margin="0,2,12,0"/><TextBlock Text="Audit trail" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel>
        </RadioButton>
        <RadioButton Style="{StaticResource Nav}" Tag="logs" Checked="Nav_Checked">
          <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE9D9;" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Margin="0,2,12,0"/><TextBlock Text="Service logs" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel>
        </RadioButton>
        <Separator Margin="16,10" Background="#334155"/>
        <RadioButton Style="{StaticResource Nav}" Tag="settings" Checked="Nav_Checked">
          <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE713;" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Margin="0,2,12,0"/><TextBlock Text="Settings" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel>
        </RadioButton>
      </StackPanel>
    </DockPanel>

    <!-- content -->
    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <Border x:Name="Toast" Margin="24,16,24,0" Padding="14,10" CornerRadius="8" Visibility="Collapsed">
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="✕" Padding="8,2" Margin="12,0,0,0" Background="Transparent" BorderThickness="0" Click="Toast_Close"/>
          <TextBlock x:Name="ToastText" TextWrapping="Wrap" VerticalAlignment="Center"/>
        </DockPanel>
      </Border>
      <ContentControl x:Name="Host" Grid.Row="1" Margin="24,16,24,20"/>
    </Grid>
  </Grid>
</Window>
