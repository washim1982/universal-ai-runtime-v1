{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uar.dev/schemas/agent.schema.json",
  "title": "UAR agent graph (apiVersion uar/v1, kind Agent)",
  "description": "Structural schema. Semantic checks (references, reachability, cycles only through loop nodes, CEL type-checks, limits) are applied by the graph compiler at registration.",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": {"const": "uar/v1"},
    "kind": {"const": "Agent"},
    "metadata": {
      "type": "object",
      "required": ["id", "version"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{1,62}$"},
        "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
        "description": {"type": "string", "maxLength": 2000}
      }
    },
    "spec": {
      "type": "object",
      "required": ["nodes", "start"],
      "additionalProperties": false,
      "properties": {
        "input": {"$ref": "#/$defs/jsonSchema"},
        "output": {"$ref": "#/$defs/jsonSchema"},
        "permissions": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "models": {"type": "array", "items": {"type": "string"}, "description": "Model patterns, e.g. local:* or cloud:default"},
            "tools": {"type": "array", "items": {"type": "string"}, "description": "Tool names or server.* patterns"},
            "agents": {"type": "array", "items": {"type": "string"}, "description": "Sub-agent ids this agent may call"}
          }
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_steps": {"type": "integer", "minimum": 1, "maximum": 1000},
            "max_loop_iterations": {"type": "integer", "minimum": 1, "maximum": 100},
            "max_tokens": {"type": "integer", "minimum": 1},
            "max_tool_calls": {"type": "integer", "minimum": 0},
            "timeout_s": {"type": "number", "exclusiveMinimum": 0, "maximum": 86400},
            "max_cost_usd": {"type": "number", "minimum": 0},
            "max_depth": {"type": "integer", "minimum": 0, "maximum": 5}
          }
        },
        "memory": {
          "type": "object",
          "additionalProperties": false,
          "properties": {"scope": {"enum": ["run"]}, "max_bytes": {"type": "integer", "minimum": 0}}
        },
        "start": {"type": "string"},
        "nodes": {"type": "array", "minItems": 1, "maxItems": 200, "items": {"$ref": "#/$defs/node"}},
        "edges": {"type": "array", "items": {"$ref": "#/$defs/edge"}}
      }
    }
  },
  "$defs": {
    "jsonSchema": {"type": "object"},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,62}$"},
    "cel": {"type": "string", "pattern": "^\\$\\{[\\s\\S]*\\}$", "description": "CEL expression wrapped in ${ }"},
    "mapping": {"description": "Literal JSON value; strings of the form ${ expr } are evaluated as CEL."},
    "edge": {
      "type": "object",
      "required": ["from", "to"],
      "additionalProperties": false,
      "properties": {"from": {"$ref": "#/$defs/id"}, "to": {"$ref": "#/$defs/id"}, "when": {"$ref": "#/$defs/cel"}}
    },
    "retry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"max_attempts": {"type": "integer", "minimum": 1, "maximum": 5}, "backoff_s": {"type": "number", "minimum": 0}}
    },
    "node": {
      "type": "object",
      "required": ["id", "type"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "type": {"enum": ["llm", "tool", "agent", "transform", "condition", "loop", "parallel", "return", "approval"]},
        "description": {"type": "string"},
        "timeout_s": {"type": "number", "exclusiveMinimum": 0},
        "retry": {"$ref": "#/$defs/retry"}
      },
      "allOf": [
        {"if": {"properties": {"type": {"const": "llm"}}}, "then": {
          "required": ["model", "prompt"],
          "properties": {
            "id": true, "type": true, "description": true, "timeout_s": true, "retry": true,
            "model": {"type": "string"}, "system": {"type": "string"}, "prompt": {"type": "string"},
            "output_schema": {"$ref": "#/$defs/jsonSchema"},
            "params": {"type": "object", "properties": {"temperature": {"type": "number"}, "max_tokens": {"type": "integer"}}, "additionalProperties": false}
          }, "additionalProperties": false}},
        {"if": {"properties": {"type": {"const": "tool"}}}, "then": {
          "required": ["tool"],
          "properties": {"id": true, "type": true, "description": true, "timeout_s": true, "retry": true,
            "tool": {"type": "string"}, "args": {"type": "object"}}, "additionalProperties": false}},
        {"if": {"properties": {"type": {"const": "agent"}}}, "then": {
          "required": ["agent"],
          "properties": {"id": true, "type": true, "description": true, "timeout_s": true, "retry": true,
            "agent": {"type": "string"}, "version": {"type": "string"}, "input": {"type": "object"}}, "additionalProperties": false}},
        {"if": {"properties": {"type": {"const": "transform"}}}, "then": {
          "properties": {"id": true, "type": true, "description": true, "timeout_s": true, "retry": true,
            "value": {"$ref": "#/$defs/mapping"}, "set": {"type": "object"}}, "additionalProperties": false}},
        {"if": {"properties": {"type": {"const": "condition"}}}, "then": {
          "properties": {"id": true, "type": true, "description": true}, "additionalProperties": false}},
        {"if": {"properties": {"type": {"const": "loop"}}}, "then": {
          "required": ["body", "max_iterations"],
          "properties": {"id": true, "type": true, "description": true,
            "while": {"$ref": "#/$defs/cel"}, "body": {"$ref": "#/$defs/id"},
            "max_iterations": {"type": "integer", "minimum": 1, "maximum": 100}}, "additionalProperties": false}},
        {"if": {"properties": {"type": {"const": "parallel"}}}, "then": {
          "required": ["branches"],
          "properties": {"id": true, "type": true, "description": true, "timeout_s": true,
            "max_concurrency": {"type": "integer", "minimum": 1, "maximum": 16},
            "branches": {"type": "object", "minProperties": 1, "maxProperties": 16,
              "additionalProperties": {"type": "object", "required": ["type"],
                "properties": {"type": {"enum": ["llm", "tool", "transform"]}}}}}, "additionalProperties": false}},
        {"if": {"properties": {"type": {"const": "return"}}}, "then": {
          "properties": {"id": true, "type": true, "description": true, "value": {"$ref": "#/$defs/mapping"}}, "additionalProperties": false}},
        {"if": {"properties": {"type": {"const": "approval"}}}, "then": {
          "properties": {"id": true, "type": true, "description": true, "action": {"type": "string"}}, "additionalProperties": false}}
      ]
    }
  }
}
