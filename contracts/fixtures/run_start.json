      "agent_id": "in_app_assistant",
      "version": "1.0.0",
      "status": "queued",
      "steps": 0,
      "current_node": "",
      "created_at": "2026-09-26T00:00:00Z",
      "updated_at": "2026-09-26T00:00:00Z",
      "parent_run_id": "",
      "cancel_requested": false
    }
  }
