{
  "name": "run_start",
  "description": "Start an agent run: 202 with a run resource.",
  "operation": "StartRun",
  "request_type": "RunRequest",
  "response_type": "Run",
  "auth": "dev",
  "request": {
    "method": "POST",
    "path": "/api/v1/agent/run",
    "body": {
      "agent_id": "in_app_assistant",
      "input": {
        "prompt": "What is the return window?"
      }
    }
