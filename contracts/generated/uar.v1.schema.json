    "DryRunRequest": {
      "type": "object",
      "properties": {
        "agent_id": {
          "type": "string",
          "description": "a registered agent (latest or `version`)"
        },
        "definition": {
          "type": "object",
          "description": "an unregistered agent document"
        },
        "inference": {
          "$ref": "#/$defs/InferenceRequest",
          "description": "routing preview only"
        },
        "version": {
          "type": "string"
        },
        "input": {
