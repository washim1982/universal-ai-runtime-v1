{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uar.dev/schemas/uar.v1.schema.json",
  "title": "uar.v1",
  "$defs": {
    "Money": {
      "type": "object",
      "properties": {
        "amount": {
          "type": "string",
          "description": "decimal string, e.g. \"0.0012\""
        },
        "currency": {
          "type": "string",
          "description": "ISO 4217"
        }
      },
      "additionalProperties": false
    },
    "Usage": {
      "type": "object",
      "properties": {
        "input_tokens": {
          "type": "integer",
          "format": "int32"
        },
        "output_tokens": {
          "type": "integer",
          "format": "int32"
        },
        "cost": {
          "$ref": "#/$defs/Money",
          "description": "Absent when no price is known for the model. Unknown is never reported as zero."
        },
        "estimated": {
          "type": "boolean",
          "description": "True when counts or cost are estimates rather than provider-reported values."
        },
        "price_version": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "Error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "description": "stable machine code, see contracts/errors.md"
        },
        "message": {
          "type": "string",
          "description": "safe for display"
        },
        "request_id": {
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        },
        "details": {
          "type": "object",
          "description": "redacted"
        }
      },
      "additionalProperties": false
    },
    "ToolCallRequest": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "args": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "ChatMessage": {
      "type": "object",
      "properties": {
        "role": {
          "type": "string",
          "description": "system | user | assistant | tool"
        },
        "content": {
          "type": "string"
        },
        "tool_calls": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ToolCallRequest"
          },
          "description": "assistant messages"
        },
        "tool_call_id": {
          "type": "string",
          "description": "tool messages"
        }
      },
      "additionalProperties": false
    },
    "GenerationParams": {
      "type": "object",
      "properties": {
        "temperature": {
          "type": "number"
        },
        "max_tokens": {
          "type": "integer",
          "format": "int32"
        },
        "top_p": {
          "type": "number"
        },
        "stop": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "response_schema": {
          "type": "object",
          "description": "Request structured output matching this JSON Schema."
        }
      },
      "additionalProperties": false
    },
    "InferenceRequest": {
      "type": "object",
      "properties": {
        "model": {
          "type": "string",
          "description": "[class \":\"] [provider \"/\"] name   e.g. local:llama3:8b, cloud:default, enterprise:corp/finance-7b"
        },
        "messages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ChatMessage"
          }
        },
        "input": {
          "type": "string",
          "description": "Shorthand for a single user message; ignored when messages is non-empty."
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Registered tool names exposed to the model for function calling."
        },
        "tool_mode": {
          "type": "string",
          "description": "\"suggest\" (default) | \"auto\""
        },
        "agent": {
          "type": "string",
          "description": "When set, runs this agent with {\"prompt\": <input>} and returns its result."
        },
        "stream": {
          "type": "boolean"
        },
        "params": {
          "$ref": "#/$defs/GenerationParams"
        },
        "data_class": {
          "type": "string",
          "description": "public | internal | confidential (policy input)"
        },
        "extensions": {
          "type": "object",
          "description": "Provider-specific extensions, namespaced by provider id, e.g. {\"ollama\": {\"keep_alive\": \"5m\"}}."
        }
      },
      "additionalProperties": false
    },
    "InferenceResponse": {
      "type": "object",
      "properties": {
        "request_id": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        },
        "model": {
          "type": "string",
          "description": "resolved provider model id"
        },
        "content": {
          "type": "string"
        },
        "finish_reason": {
          "type": "string",
          "description": "stop | length | tool_calls | cancelled | error"
        },
        "tool_calls": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ToolCallRequest"
          }
        },
        "usage": {
          "$ref": "#/$defs/Usage"
        },
        "run_id": {
          "type": "string",
          "description": "set when the call ran an agent or the auto tool loop"
        },
        "output": {
          "type": "object",
          "description": "agent structured output, if any"
        },
        "route": {
          "$ref": "#/$defs/RouteDecision"
        }
      },
      "additionalProperties": false
    },
    "RouteDecision": {
      "type": "object",
      "properties": {
        "requested": {
          "type": "string"
        },
        "model_class": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "fallback_used": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "ToolRequest": {
      "type": "object",
      "properties": {
        "tool": {
          "type": "string",
          "description": "namespaced, e.g. fs.read_text"
        },
        "args": {
          "type": "object"
        },
        "idempotency_key": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "ContentBlock": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "description": "text | json"
        },
        "text": {
          "type": "string"
        },
        "json": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "ToolResult": {
      "type": "object",
      "properties": {
        "request_id": {
          "type": "string"
        },
        "tool": {
          "type": "string"
        },
        "is_error": {
          "type": "boolean"
        },
        "content": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ContentBlock"
          }
        },
        "structured": {
          "type": "object"
        },
        "truncated": {
          "type": "boolean"
        },
        "untrusted": {
          "type": "boolean",
          "description": "Tool output is untrusted data and must never be treated as instructions."
        },
        "duration_ms": {
          "type": "integer",
          "format": "int32"
        }
      },
      "additionalProperties": false
    },
    "ToolInfo": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "server": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "input_schema": {
          "type": "object"
        },
        "side_effect": {
          "type": "string",
          "description": "read | write | external"
        }
      },
      "additionalProperties": false
    },
    "ListToolsRequest": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    },
    "ListToolsResponse": {
      "type": "object",
      "properties": {
        "tools": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ToolInfo"
          }
        }
      },
      "additionalProperties": false
    },
    "ModelInfo": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "alias or class-qualified name"
        },
        "model_class": {
          "type": "string",
          "description": "local | cloud | enterprise"
        },
        "provider": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "chat, stream, tools, json, vision"
        },
        "available": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "ListModelsRequest": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    },
    "ListModelsResponse": {
      "type": "object",
      "properties": {
        "models": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ModelInfo"
          }
        }
      },
      "additionalProperties": false
    },
    "RegisterAgentRequest": {
      "type": "object",
      "properties": {
        "definition": {
          "type": "object",
          "description": "Agent document (apiVersion uar/v1, kind Agent), validated against\n contracts/schemas/agent.schema.json."
        }
      },
      "additionalProperties": false
    },
    "AgentVersion": {
      "type": "object",
      "properties": {
        "agent_id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "description": "sha256 of canonical JSON"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "RunRequest": {
      "type": "object",
      "properties": {
        "agent_id": {
          "type": "string"
        },
        "version": {
          "type": "string",
          "description": "empty = latest registered"
        },
        "input": {
          "type": "object"
        },
        "idempotency_key": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "Run": {
      "type": "object",
      "properties": {
        "run_id": {
          "type": "string"
        },
        "agent_id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "description": "queued | running | waiting_approval | succeeded | failed | cancelled | needs_attention"
        },
        "output": {
          "type": "object"
        },
        "error": {
          "$ref": "#/$defs/Error"
        },
        "usage": {
          "$ref": "#/$defs/Usage"
        },
        "steps": {
          "type": "integer",
          "format": "int32"
        },
        "current_node": {
          "type": "string"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "parent_run_id": {
          "type": "string"
        },
        "cancel_requested": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "GetRunRequest": {
      "type": "object",
      "properties": {
        "run_id": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "WatchRunRequest": {
      "type": "object",
      "properties": {
        "run_id": {
          "type": "string"
        },
        "after_seq": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "CancelRunRequest": {
      "type": "object",
      "properties": {
        "run_id": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "ResolveRunRequest": {
      "type": "object",
      "properties": {
        "run_id": {
          "type": "string"
        },
        "action": {
          "type": "string",
          "description": "mark_completed | retry_node | fail"
        },
        "note": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "Started": {
      "type": "object",
      "properties": {
        "model": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        },
        "agent_id": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "TokenDelta": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "ToolCallEvent": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "tool": {
          "type": "string"
        },
        "args": {
          "type": "object"
        },
        "node_id": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "ToolResultEvent": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "tool": {
          "type": "string"
        },
        "is_error": {
          "type": "boolean"
        },
        "summary": {
          "type": "string"
        },
        "node_id": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "NodeStarted": {
      "type": "object",
      "properties": {
        "node_id": {
          "type": "string"
        },
        "node_type": {
          "type": "string"
        },
        "attempt": {
          "type": "integer",
          "format": "int32"
        }
      },
      "additionalProperties": false
    },
    "NodeCompleted": {
      "type": "object",
      "properties": {
        "node_id": {
          "type": "string"
        },
        "outcome": {
          "type": "string"
        },
        "duration_ms": {
          "type": "integer",
          "format": "int32"
        },
        "next": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "ApprovalRequired": {
      "type": "object",
      "properties": {
        "approval_id": {
          "type": "string"
        },
        "action": {
          "type": "string"
        },
        "args_hash": {
          "type": "string"
        },
        "node_id": {
          "type": "string"
        },
        "expires_at": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "Completed": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string"
        },
        "content": {
          "type": "string"
        },
        "output": {
          "type": "object"
        },
        "finish_reason": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "Event": {
      "type": "object",
      "properties": {
        "run_id": {
          "type": "string"
        },
        "seq": {
          "type": "integer",
          "minimum": 0
        },
        "ts": {
          "type": "string",
          "format": "date-time"
        },
        "trace_id": {
          "type": "string"
        },
        "request_id": {
          "type": "string"
        },
        "started": {
          "$ref": "#/$defs/Started"
        },
        "token": {
          "$ref": "#/$defs/TokenDelta"
        },
        "tool_call": {
          "$ref": "#/$defs/ToolCallEvent"
        },
        "tool_result": {
          "$ref": "#/$defs/ToolResultEvent"
        },
        "node_started": {
          "$ref": "#/$defs/NodeStarted"
        },
        "node_completed": {
          "$ref": "#/$defs/NodeCompleted"
        },
        "usage": {
          "$ref": "#/$defs/Usage"
        },
        "approval_required": {
          "$ref": "#/$defs/ApprovalRequired"
        },
        "error": {
          "$ref": "#/$defs/Error",
          "description": "terminal"
        },
        "completed": {
          "$ref": "#/$defs/Completed",
          "description": "terminal"
        },
        "type": {
          "type": "string",
          "enum": [
            "started",
            "token",
            "tool_call",
            "tool_result",
            "node_started",
            "node_completed",
            "usage",
            "approval_required",
            "error",
            "completed"
          ],
          "description": "Name of the populated body field (JSON/SSE only)."
        }
      },
      "additionalProperties": false,
      "x-oneof": {
        "body": [
          "started",
          "token",
          "tool_call",
          "tool_result",
          "node_started",
          "node_completed",
          "usage",
          "approval_required",
          "error",
          "completed"
        ]
      },
      "allOf": [
        {
          "not": {
            "required": [
              "started",
              "token"
            ]
          }
        },
        {
          "not": {
            "required": [
              "started",
              "tool_call"
            ]
          }
        },
        {
          "not": {
            "required": [
              "started",
              "tool_result"
            ]
          }
        },
        {
          "not": {
            "required": [
              "started",
              "node_started"
            ]
          }
        },
        {
          "not": {
            "required": [
              "started",
              "node_completed"
            ]
          }
        },
        {
          "not": {
            "required": [
              "started",
              "usage"
            ]
          }
        },
        {
          "not": {
            "required": [
              "started",
              "approval_required"
            ]
          }
        },
        {
          "not": {
            "required": [
              "started",
              "error"
            ]
          }
        },
        {
          "not": {
            "required": [
              "started",
              "completed"
            ]
          }
        },
        {
          "not": {
            "required": [
              "token",
              "tool_call"
            ]
          }
        },
        {
          "not": {
            "required": [
              "token",
              "tool_result"
            ]
          }
        },
        {
          "not": {
            "required": [
              "token",
              "node_started"
            ]
          }
        },
        {
          "not": {
            "required": [
              "token",
              "node_completed"
            ]
          }
        },
        {
          "not": {
            "required": [
              "token",
              "usage"
            ]
          }
        },
        {
          "not": {
            "required": [
              "token",
              "approval_required"
            ]
          }
        },
        {
          "not": {
            "required": [
              "token",
              "error"
            ]
          }
        },
        {
          "not": {
            "required": [
              "token",
              "completed"
            ]
          }
        },
        {
          "not": {
            "required": [
              "tool_call",
              "tool_result"
            ]
          }
        },
        {
          "not": {
            "required": [
              "tool_call",
              "node_started"
            ]
          }
        },
        {
          "not": {
            "required": [
              "tool_call",
              "node_completed"
            ]
          }
        },
        {
          "not": {
            "required": [
              "tool_call",
              "usage"
            ]
          }
        },
        {
          "not": {
            "required": [
              "tool_call",
              "approval_required"
            ]
          }
        },
        {
          "not": {
            "required": [
              "tool_call",
              "error"
            ]
          }
        },
        {
          "not": {
            "required": [
              "tool_call",
              "completed"
            ]
          }
        },
        {
          "not": {
            "required": [
              "tool_result",
              "node_started"
            ]
          }
        },
        {
          "not": {
            "required": [
              "tool_result",
              "node_completed"
            ]
          }
        },
        {
          "not": {
            "required": [
              "tool_result",
              "usage"
            ]
          }
        },
        {
          "not": {
            "required": [
              "tool_result",
              "approval_required"
            ]
          }
        },
        {
          "not": {
            "required": [
              "tool_result",
              "error"
            ]
          }
        },
        {
          "not": {
            "required": [
              "tool_result",
              "completed"
            ]
          }
        },
        {
          "not": {
            "required": [
              "node_started",
              "node_completed"
            ]
          }
        },
        {
          "not": {
            "required": [
              "node_started",
              "usage"
            ]
          }
        },
        {
          "not": {
            "required": [
              "node_started",
              "approval_required"
            ]
          }
        },
        {
          "not": {
            "required": [
              "node_started",
              "error"
            ]
          }
        },
        {
          "not": {
            "required": [
              "node_started",
              "completed"
            ]
          }
        },
        {
          "not": {
            "required": [
              "node_completed",
              "usage"
            ]
          }
        },
        {
          "not": {
            "required": [
              "node_completed",
              "approval_required"
            ]
          }
        },
        {
